            "mimeType": "application/javascript",
            "text": "(function () {\n    'use strict';\n\n    var STORAGE_KEY = 'bgMusicTime';\n    var ENABLED_KEY = 'bgMusicEnabled';\n    var AUDIO_FILE = 'bg.mp3';\n\n    function getRootWindow() {\n        try {\n            if (window.top && window.top !== window && window.top.location.origin === window.location.origin) {\n                return window.top;\n            }\n        } catch (e) {}\n\n        return window;\n    }\n\n    var root = getRootWindow();\n\n    /*\n      If this page is opened inside iframe, do not create a second audio.\n      Use the parent audio manager instead.\n    */\n    if (root !== window) {\n        function bindParentMusic() {\n            try {\n                if (!root.__bgMusicManager) return;\n\n                window.__bgMusicManager = root.__bgMusicManager;\n                window._bgAudio = root.__bgMusicManager.audio;\n\n                window.isMusicEnabled = root.__bgMusicManager.isEnabled;\n                window.setMusicEnabled = root.__bgMusicManager.setEnabled;\n                window.setBgMusicEnabled = root.__bgMusicManager.setEnabled;\n                window.tryPlayBgMusic = root.__bgMusicManager.tryPlay;\n                window.pauseBgMusic = root.__bgMusicManager.pause;\n            } catch (e) {}\n        }\n\n        bindParentMusic();\n        document.addEventListener('DOMContentLoaded', bindParentMusic);\n        setTimeout(bindParentMusic, 300);\n\n        return;\n    }\n\n    /*\n      If music manager already exists in the main window,\n      do not create a new Audio object.\n    */\n    if (window.__bgMusicManager) {\n        window._bgAudio = window.__bgMusicManager.audio;\n        return;\n    }\n\n    var audio = new Audio(AUDIO_FILE);\n    audio.loop = true;\n    audio.volume = 0.35;\n\n    var unlockBound = false;\n\n    function isMusicEnabled() {\n        var v = localStorage.getItem(ENABLED_KEY);\n        return v === null ? true : v === '1';\n    }\n\n    function saveTime() {\n        try {\n            sessionStorage.setItem(STORAGE_KEY, String(audio.currentTime || 0));\n        } catch (e) {}\n    }\n\n    function restoreTime() {\n        try {\n            var saved = parseFloat(sessionStorage.getItem(STORAGE_KEY) || '0');\n            if (saved > 0 && isFinite(saved)) {\n                audio.currentTime = saved;\n            }\n        } catch (e) {}\n    }\n\n    function pauseMusic() {\n        saveTime();\n        audio.pause();\n    }\n\n    function bindUnlockPlay() {\n        if (unlockBound) return;\n        unlockBound = true;\n\n        var events = ['touchstart', 'mousedown', 'keydown', 'pointerdown', 'click'];\n\n        function unlock() {\n            if (!isMusicEnabled()) return;\n\n            audio.play().catch(function () {});\n            events.forEach(function (ev) {\n                document.removeEventListener(ev, unlock, true);\n            });\n        }\n\n        events.forEach(function (ev) {\n            document.addEventListener(ev, unlock, { once: true, capture: true });\n        });\n    }\n\n    function tryPlay() {\n        if (!isMusicEnabled()) {\n            pauseMusic();\n            return;\n        }\n\n        audio.play().catch(function () {\n            bindUnlockPlay();\n        });\n    }\n\n    function setMusicEnabled(enabled) {\n        localStorage.setItem(ENABLED_KEY, enabled ? '1' : '0');\n\n        if (enabled) {\n            tryPlay();\n        } else {\n            pauseMusic();\n        }\n    }\n\n    window.__bgMusicManager = {\n        audio: audio,\n        isEnabled: isMusicEnabled,\n        setEnabled: setMusicEnabled,\n        tryPlay: tryPlay,\n        pause: pauseMusic\n    };\n\n    /* Compatibility with existing profile music toggle */\n    window._bgAudio = audio;\n    window.isMusicEnabled = isMusicEnabled;\n    window.setMusicEnabled = setMusicEnabled;\n    window.setBgMusicEnabled = setMusicEnabled;\n    window.tryPlayBgMusic = tryPlay;\n    window.pauseBgMusic = pauseMusic;\n\n    restoreTime();\n\n    window.addEventListener('beforeunload', saveTime);\n    window.addEventListener('pagehide', saveTime);\n\n    tryPlay();\n\n    if (window.Telegram && window.Telegram.WebApp) {\n        window.Telegram.WebApp.onEvent('viewportChanged', tryPlay);\n    }\n\n    document.addEventListener('visibilitychange', function () {\n        if (!document.hidden) {\n            tryPlay();\n        } else {\n            saveTime();\n        }\n    });\n\n    window.addEventListener('storage', function (e) {\n        if (e.key !== ENABLED_KEY) return;\n\n        if (e.newValue === '0') {\n            pauseMusic();\n        } else {\n            tryPlay();\n        }\n    });\n})();\n"
