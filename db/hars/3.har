          "content": {
            "size": 29906,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\"> \n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Skill Tournament</title>\n    <link rel=\"stylesheet\" href=\"style.css?v=1775106548\">\n    <link rel=\"stylesheet\" href=\"index.css?v=1779292989\">\n    <script src=\"https://telegram.org/js/telegram-web-app.js\"></script>\n    <script src=\"music.js?v=1779273169\"></script>\n    <script src=\"footer.js?v=1779217858\" defer></script>\n    <script src=\"block.js\" defer></script>\n\n<style>\nbody {\n    background: linear-gradient(160deg,\n        #0a0118 0%,\n        #130228 20%,\n        #1c0535 40%,\n        #180320 60%,\n        #0e0120 80%,\n        #080012 100%\n    ) !important;\n    background-attachment: fixed !important;\n}\n#bg-shapes-layer {\n    position: fixed;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    z-index: -1;\n    overflow: hidden;\n    transition: opacity 0.6s ease;\n}\n\n#bg-shapes-layer.hidden {\n    opacity: 0;\n}\n\n.bg-shape {\n    position: absolute;\n    top: -120px;\n    opacity: 0;\n    animation: bg-fall linear infinite;\n    will-change: transform, opacity;\n}\n\n.bg-shape svg {\n    display: block;\n}\n\n@keyframes bg-fall {\n    0%   { transform: translateY(0) rotate(0deg);    opacity: 0;    }\n    8%   { opacity: 1; }\n    88%  { opacity: 1; }\n    100% { transform: translateY(115vh) rotate(280deg); opacity: 0; }\n}\nbody{padding-top:115px !important;}\n</style>\n</head>\n<body>\n\n<svg xmlns=\"http://www.w3.org/2000/svg\" style=\"display:none\">\n  <symbol id=\"ico-trophy\" viewBox=\"0 0 64 64\"><path fill=\"currentColor\" d=\"M48 6H16v4H8v8c0 6.627 5.373 12 12 12a16.07 16.07 0 0 0 8.078 2.943C29.02 35.98 30 39.308 30 42h-6a6 6 0 0 0-6 6v4h28v-4a6 6 0 0 0-6-6h-6c0-2.692.98-6.02 1.922-9.057A16.07 16.07 0 0 0 44 30c6.627 0 12-5.373 12-12v-8h-8V6zM10 18v-6h6v14.8A10.005 10.005 0 0 1 10 18zm44 0a10.005 10.005 0 0 1-6 8.8V12h6v6z\"/></symbol>\n  <symbol id=\"ico-users\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-.36 0-.7.07-1.01.2a4.97 4.97 0 0 1 0 5.6c.31.13.65.2 1.01.2ZM8 11c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05A4.64 4.64 0 0 1 17 15.5V19h5v-2.5C22 14.17 18.33 13 16 13Z\"/></symbol>\n  <symbol id=\"ico-skull\" viewBox=\"0 0 32 32\"><path fill=\"#ef4444\" d=\"M29,14c0-7.18-5.82-13-13-13S3,6.82,3,14c0,5.257,3.127,9.775,7.617,11.823l-0.515,1.544c-0.349,1.048,0.217,2.181,1.265,2.53c0.209,0.07,0.423,0.104,0.633,0.104c0.837,0,1.618-0.53,1.897-1.368L14,28.325V29c0,1.104,0.896,2,2,2s2-0.896,2-2v-0.675l0.103,0.308c0.279,0.838,1.06,1.368,1.897,1.368c0.21,0,0.423-0.033,0.633-0.104c1.048-0.35,1.614-1.482,1.265-2.53l-0.515-1.544C25.873,23.775,29,19.257,29,14z M10,20c-2.209,0-4-2.239-4-5s1.791-5,4-5s4,2.239,4,5S12.209,20,10,20z M22,20c-2.209,0-4-2.239-4-5s1.791-5,4-5s4,2.239,4,5S24.209,20,22,20z\"/></symbol>\n  <symbol id=\"ico-check\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"currentColor\"/><path fill=\"#ffffff\" d=\"M10 17l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8z\"/></symbol>\n  <symbol id=\"ico-clock\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8Zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7Z\"/></symbol>\n  <symbol id=\"ico-party\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M2 22 4.5 9.5 9 14l3-3 5 5-3 3L22 22H2ZM14 2l2 4-4 2 2 4-3 1-2-4 4-2-2-4 3-1Zm5 4 1 2-2 1 1 2h-2l-1-2 2-1-1-2h2Z\"/></symbol>\n  <symbol id=\"ico-ban\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm0 18c-4.42 0-8-3.58-8-8 0-1.85.63-3.55 1.69-4.9L16.9 18.31A7.9 7.9 0 0 1 12 20Zm6.31-3.1L7.1 5.69A7.9 7.9 0 0 1 12 4c4.42 0 8 3.58 8 8a7.9 7.9 0 0 1-1.69 4.9Z\"/></symbol>\n  <symbol id=\"ico-return\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M9 18l-6-6 6-6v4h7c1.1 0 2-.9 2-2V4h2v4c0 2.21-1.79 4-4 4H9v4Zm12 0h-2v-4a4 4 0 0 0-4-4h-1v-2h1a6 6 0 0 1 6 6v4Z\"/></symbol>\n  <symbol id=\"ico-lock\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2Zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2Zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2Z\"/></symbol>\n  <symbol id=\"ico-star\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01L12 2Z\"/></symbol>\n  <symbol id=\"ico-medal1\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"14\" r=\"7\" fill=\"#FFD700\" stroke=\"#DAA520\" stroke-width=\"1\"/><path d=\"M8 2h3l1 5h-3L8 2Zm5 0h3l1 5h-3l-1-5Z\" fill=\"#FFD700\"/><text x=\"12\" y=\"17\" text-anchor=\"middle\" font-size=\"8\" font-weight=\"bold\" fill=\"#8B6914\">1</text></symbol>\n  <symbol id=\"ico-medal2\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"14\" r=\"7\" fill=\"#C0C0C0\" stroke=\"#A0A0A0\" stroke-width=\"1\"/><path d=\"M8 2h3l1 5h-3L8 2Zm5 0h3l1 5h-3l-1-5Z\" fill=\"#C0C0C0\"/><text x=\"12\" y=\"17\" text-anchor=\"middle\" font-size=\"8\" font-weight=\"bold\" fill=\"#666\">2</text></symbol>\n  <symbol id=\"ico-medal3\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"14\" r=\"7\" fill=\"#CD7F32\" stroke=\"#A0522D\" stroke-width=\"1\"/><path d=\"M8 2h3l1 5h-3L8 2Zm5 0h3l1 5h-3l-1-5Z\" fill=\"#CD7F32\"/><text x=\"12\" y=\"17\" text-anchor=\"middle\" font-size=\"8\" font-weight=\"bold\" fill=\"#5C3317\">3</text></symbol>\n  <symbol id=\"ico-crown\" viewBox=\"0 0 24 24\"><path fill=\"#FFD700\" d=\"M2 19h20v3H2v-3Zm1-1L5 6l4.5 5L12 3l2.5 8L19 6l2 12H3Z\"/></symbol>\n  <symbol id=\"ico-knife\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 2L9 13h6L12 2Zm-1 13h2v7h-2v-7Z\"/></symbol>\n  <symbol id=\"ico-target\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"2\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"ico-close\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12Z\"/></symbol>\n  <symbol id=\"ico-bolt\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13.01 3h1l-1 7h3.51c.4 0 .62.19.4.66C12.97 17.55 11 21 11 21Z\"/></symbol>\n  <symbol id=\"ico-ghost\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 2a8 8 0 0 0-8 8v12l3-3 3 3 2-2 2 2 3-3 3 3V10a8 8 0 0 0-8-8Zm-2 10a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm4 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z\"/></symbol>\n  <symbol id=\"ico-fire\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 23c-4.97 0-7-3.58-7-7 0-3.87 3.14-6.74 4.5-9.14.68-1.2 1.5-2.86 1.5-4.86 0 0 2 1.33 2 5 .58-.67 1-1.67 1-3 3 2.33 4 5.33 4 8 0 3.42-2.03 7-6 7-1.82 0-3.5-.95-4.38-2.5C6.81 16.78 7 15.62 7 15c0-1.67 1-3 1-3s1 1.33 2 1c.62-.2 1-1 1-1s1.5 1 1.5 3c0 1.5-1 2.5-2 2.5.83.83 2 .83 2 .83A4 4 0 0 0 16 14.5c0-.83-.17-1.5-.5-2.17 0 0-1.5 1.17-2.5.67 1-1.33 1-2.5 1-2.5S12 12 10.5 12 8 10.5 8 10.5L7 12Z\"/></symbol>\n</svg>\n\n<style>\n.ico{width:1em;height:1em;display:inline-block;vertical-align:-0.125em;fill:currentColor;flex-shrink:0}\n.ico-sm{width:14px;height:14px}\n.ico-md{width:18px;height:18px}\n.ico-lg{width:24px;height:24px}\n.ico-xl{width:32px;height:32px}\n.ico-xxl{width:48px;height:48px}\n.ico-huge{width:64px;height:64px}\n.ico-gold{color:#FFD700}\n.ico-green{color:#22c55e}\n.ico-red{color:#ef4444}\n.ico-pink{color:#d336ff}\n.ico-white{color:#fff}\n@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}\n.skeleton{background:linear-gradient(90deg,rgba(255,255,255,.04) 25%,rgba(255,255,255,.08) 50%,rgba(255,255,255,.04) 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:6px;color:transparent!important}\n.skeleton *{visibility:hidden}\n@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}\n@keyframes scaleIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}\n.anim-fade-up{animation:fadeUp .4s ease both}\n.anim-scale-in{animation:scaleIn .35s ease both}\n.anim-d1{animation-delay:.05s}.anim-d2{animation-delay:.1s}.anim-d3{animation-delay:.15s}.anim-d4{animation-delay:.2s}\n#tgo-between-icon{transition:transform .5s cubic-bezier(.2,.8,.2,1)}\n#tgo-between-icon.pop{transform:scale(1.2)}\n.mini-card{transition:transform .2s ease,box-shadow .2s ease}\n.mini-card:active{transform:scale(.97)}\n</style>\n\n<!-- ── Falling background shapes (main page only) ── -->\n<div id=\"bg-shapes-layer\"></div>\n\n\n\n<div id=\"loader\"><div class=\"loader-box\">\n    <div class=\"spinner\"></div>\n    <div class=\"loader-shapes\">\n        <div class=\"shape circle\"></div>\n        <div class=\"shape triangle\"></div>\n        <div class=\"shape square\"></div>\n    </div>\n</div></div>\n\n<div class=\"popup-backdrop\" id=\"lb-popup\">\n    <div class=\"popup-sheet\">\n        <div class=\"popup-handle\"></div>\n        <div class=\"popup-header\">\n            <span class=\"popup-title\">Лидерборд</span>\n            <button class=\"popup-close\" onclick=\"closePopup('lb-popup')\"><svg class=\"ico ico-sm\"><use xlink:href=\"#ico-close\"/></svg></button>\n        </div>\n        <div class=\"popup-tabs\" style=\"padding:0 16px\">\n            <div class=\"ptab active\" id=\"ptab-wins\" onclick=\"setLbMode('wins')\"><svg class=\"ico ico-sm ico-gold\"><use xlink:href=\"#ico-trophy\"/></svg> По победам</div>\n             <div class=\"ptab\" id=\"ptab-ton\" onclick=\"setLbMode('ton')\">По <img src=\"svg/ton.svg\" alt=\"ton\"></div>\n        </div>\n        <div class=\"popup-body\"><div id=\"lb-top3\"></div><div id=\"lb-list-popup\"></div></div>\n    </div>\n</div>\n\n<div class=\"popup-backdrop\" id=\"lg-popup\">\n    <div class=\"popup-sheet\">\n        <div class=\"popup-handle\"></div>\n        <div class=\"popup-header\">\n            <div>\n                <span class=\"popup-title\">Прошлые игры</span>\n                <div style=\"font-size:12px;color:rgba(255,255,255,.4);margin-top:2px;\">История турниров</div>\n            </div>\n            <button class=\"popup-close\" onclick=\"closePopup('lg-popup')\"><svg class=\"ico ico-sm\"><use xlink:href=\"#ico-close\"/></svg></button>\n        </div>\n        <div class=\"popup-body\"><div id=\"lg-list-popup\"><div class=\"lg-empty\">Нет данных</div></div></div>\n    </div>\n</div>\n\n<div id=\"game-overlay\">\n\n    <div id=\"tgo-header\" style=\"padding-top: 100px;\">\n        <div>\n            <div id=\"tgo-round-label\">РАУНД 1 / 4</div>\n            <div id=\"tgo-game-name\">RED LIGHT GREEN LIGHT</div>\n        </div>\n        <div style=\"display:flex;flex-direction:column;align-items:flex-end;gap:6px\">\n            <div id=\"tgo-alive-count\"><svg class=\"ico ico-sm\" style=\"color:#d336ff\"><use xlink:href=\"#ico-users\"/></svg> —</div>\n        </div>\n    </div>\n\n    <div id=\"game-rules\" class=\"game-screen active\">\n        <div class=\"rules-card\">\n            <div class=\"rules-header\">ИНСТРУКЦИЯ</div>\n            <h2 class=\"rules-main-title\">RED LIGHT<br>GREEN LIGHT</h2>\n            <div class=\"rules-divider\"></div>\n            <p class=\"rules-item\"><span class=\"dot green\"></span> Удерживай кнопку, пока горит <span class=\"green-text\">ЗЕЛЕНЫЙ</span></p>\n            <p class=\"rules-item\"><span class=\"dot red\"></span> Немедленно отпусти на <span class=\"red-text\">КРАСНЫЙ</span></p>\n            <p class=\"rules-item\"><span class=\"dot pink\"></span> Заполни шкалу до 100%, чтобы выжить</p>\n            <div class=\"rules-cap-info\" id=\"rlgl-cap-info\">Дальше проходят все игроки, которые выполнили задание. Если никто не прошёл, сервер выберет лучших по времени.</div>\n            <div class=\"rules-footer\">Игра начнется через несколько секунд...</div>\n        </div>\n    </div>\n\n    <div id=\"game-countdown\" class=\"game-screen\">\n        <div class=\"countdown-wrapper\">\n            <div class=\"countdown-number\" id=\"countdown-val\">5</div>\n            <div class=\"countdown-label\">ПРИГОТОВИТЬСЯ</div>\n        </div>\n    </div>\n\n    <div id=\"game-play\" class=\"game-screen\" style=\"position:relative\">\n        <div class=\"round-pass-counter\" style=\"position:fixed;top:105px;right:15px;z-index:10\">\n            <span class=\"rpc-passed\">0</span><span class=\"rpc-sep\">/</span><span class=\"rpc-cap\">0</span>\n            <span class=\"rpc-label\">прошли</span>\n        </div>\n        <div class=\"round-timer\" id=\"round-timer\">00:45</div>\n        <div class=\"light-indicator\" id=\"light-indicator\"></div>\n        <div class=\"progress-container-circle\">\n            <svg class=\"progress-svg\" viewBox=\"0 0 100 100\">\n                <circle class=\"bg\" cx=\"50\" cy=\"50\" r=\"45\"></circle>\n                <circle class=\"bar\" id=\"player-progress-circle\" cx=\"50\" cy=\"50\" r=\"45\"></circle>\n            </svg>\n            <div class=\"progress-text\" id=\"progress-percent\">0%</div>\n        </div>\n        <button id=\"main-game-btn\" class=\"main-game-btn\">УДЕРЖИВАТЬ</button>\n    </div>\n\n    <div id=\"game-result\" class=\"game-screen\">\n        <div class=\"result-card\" style=\"text-align:center;padding:24px\">\n            <h2 id=\"result-title\" style=\"font-size:36px;font-weight:900;margin:0 0 10px\">РЕЗУЛЬТАТ</h2>\n            <p id=\"result-desc\" style=\"font-size:15px;color:rgba(255,255,255,.6);margin:0 0 20px\"></p>\n        </div>\n    </div>\n\n    <div id=\"game-transition\" class=\"game-screen\">\n        <div class=\"rules-card\">\n            <div class=\"rules-header\">ИНСТРУКЦИЯ</div>\n            <h2 class=\"rules-main-title\">DALGONA</h2>\n            <div class=\"rules-divider\"></div>\n            <p class=\"rules-item rules-list\"><span class=\"dot pink\"></span> Вырежи фигуру по контуру</p>\n            <p class=\"rules-item rules-list\"><span class=\"dot red\"></span> Сойдешь с контура — <span class=\"red-text\">СМЕРТЬ</span></p>\n            <p class=\"rules-item rules-list\"><span class=\"dot green\"></span> Отрывать руку можно</p>\n            <div class=\"rules-cap-info\" id=\"dalgona-cap-info\">Дальше проходят все игроки, которые выполнили задание. Если никто не прошёл, сервер выберет лучших по времени.</div>\n            <div class=\"rules-footer\">Игра начнется через несколько секунд...</div>\n        </div>\n    </div>\n\n    <div id=\"game-dalgona\" class=\"game-screen\">\n        <div class=\"dalgona-container\" style=\"position:relative\">\n            <div class=\"timer\" id=\"timer\">01:00</div>\n            <div class=\"round-pass-counter\" style=\"position:fixed;top:105px;right:15px;z-index:10\">\n                <span class=\"rpc-passed\">0</span><span class=\"rpc-sep\">/</span><span class=\"rpc-cap\">0</span>\n                <span class=\"rpc-label\">прошли</span>\n            </div>\n            <div class=\"candy\" id=\"candy\">\n                <svg viewBox=\"0 0 300 300\">\n                    <path id=\"shape\"/>\n                    <path id=\"line\"/>\n                </svg>\n            </div>\n            <div class=\"percent\" id=\"percent\">0%</div>\n            <p class=\"dalgona-hint\">Веди точно по контуру</p>\n        </div>\n    </div>\n\n    <div id=\"game-fiveclicks-rules\" class=\"game-screen\">\n        <div class=\"rules-card\">\n            <div class=\"rules-header\">ИНСТРУКЦИЯ</div>\n            <h2 class=\"rules-main-title\">PRECISIO