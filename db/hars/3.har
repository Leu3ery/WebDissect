            "size": 13054,
            "mimeType": "application/javascript",
            "text": "(function () {\n    var embeddedStyle = document.createElement(\"style\");\n    embeddedStyle.textContent = \"#embedded-page-wrap{bottom:0!important}.bottom-nav{z-index:1200!important}\";\n    document.head.appendChild(embeddedStyle);\n\n    function isGameRoot() {\n        var p = window.location.pathname;\n        return p === \"/\" || p === \"/index.php\" || p === \"/app/\" || p === \"/app/index.php\";\n    }\n\n    function setActiveNav(id) {\n        document.querySelectorAll(\".bottom-nav .nav-item\").forEach(function (el) {\n            el.classList.toggle(\"active\", el.id === id);\n        });\n    }\n\n    function ensureEmbeddedFrame() {\n        var wrap = document.getElementById(\"embedded-page-wrap\");\n        if (wrap) return wrap;\n\n        wrap = document.createElement(\"div\");\n        wrap.id = \"embedded-page-wrap\";\n        wrap.style.cssText = [\n            \"position:fixed\",\n            \"left:0\",\n            \"right:0\",\n            \"top:0\",\n            \"bottom:86px\",\n            \"z-index:900\",\n            \"background:#080012\",\n            \"display:none\",\n            \"overflow:hidden\"\n        ].join(\";\");\n\n        var iframe = document.createElement(\"iframe\");\n        iframe.id = \"embedded-page-frame\";\n        iframe.setAttribute(\"title\", \"page\");\n        iframe.style.cssText = [\n            \"border:0\",\n            \"width:100%\",\n            \"height:100%\",\n            \"background:#080012\"\n        ].join(\";\");\n\n        wrap.appendChild(iframe);\n        document.body.appendChild(wrap);\n\n        iframe.addEventListener(\"load\", function () {\n            try {\n                var doc = iframe.contentDocument;\n                if (!doc) return;\n\n                var nav = doc.querySelector(\".bottom-nav\");\n                if (nav) nav.style.display = \"none\";\n\n                if (doc.body) {\n                    doc.body.style.paddingBottom = \"0px\";\n                }\n            } catch (e) {}\n        });\n\n        return wrap;\n    }\n\n    function closeEmbeddedPage() {\n        var wrap = document.getElementById(\"embedded-page-wrap\");\n        if (wrap) wrap.style.display = \"none\";\n        setActiveNav(\"game\");\n    }\n\n    function closeEmbeddedPageIfTournamentStarted() {\n        var wrap = document.getElementById(\"embedded-page-wrap\");\n        if (!wrap || wrap.style.display === \"none\") return;\n\n        if (window.inTournament === true) {\n            closeEmbeddedPage();\n        }\n    }\n\n    window.closeEmbeddedPage = closeEmbeddedPage;\n\n    setInterval(closeEmbeddedPageIfTournamentStarted, 500);\n\n    function openEmbeddedPage(url, id) {\n        if (!isGameRoot()) {\n            window.location.href = url;\n            return;\n        }\n\n        if (window.inTournament === true) {\n            closeEmbeddedPage();\n            return;\n        }\n\n        var wrap = ensureEmbeddedFrame();\n        var iframe = document.getElementById(\"embedded-page-frame\");\n        var fullUrl = url + (url.indexOf(\"?\") >= 0 ? \"&\" : \"?\") + \"embed=1\";\n\n        if (iframe.getAttribute(\"data-src\") !== fullUrl) {\n            iframe.setAttribute(\"data-src\", fullUrl);\n            iframe.src = fullUrl;\n        }\n\n        wrap.style.display = \"block\";\n        setActiveNav(id);\n    }\n\n\n    var TON_BRIDGE_MANIFEST_URL = \"https://pabloserverbot.duckdns.org/tonconnect-manifest.json\";\n    var TON_BRIDGE_WALLETS_LIST = \"https://raw.githubusercontent.com/ton-blockchain/wallets-list/main/wallets-v2.json\";\n    var TON_BRIDGE_TWA_RETURN_URL = \"https://t.me/Squid_Game1bot?start\";\n    var parentTonConnectUI = null;\n    var tonConnectScriptLoading = null;\n\n    function getEmbeddedIframe() {\n        return document.getElementById(\"embedded-page-frame\");\n    }\n\n    function replyToEmbeddedProfile(requestId, payload) {\n        var iframe = getEmbeddedIframe();\n        if (!iframe || !iframe.contentWindow) return;\n\n        payload = payload || {};\n        payload.type = \"ton_wallet_change_result\";\n        payload.requestId = requestId || null;\n\n        iframe.contentWindow.postMessage(payload, window.location.origin);\n    }\n\n    function loadTonConnectUiScript() {\n        if (window.TON_CONNECT_UI) return Promise.resolve();\n\n        if (tonConnectScriptLoading) return tonConnectScriptLoading;\n\n        tonConnectScriptLoading = new Promise(function (resolve, reject) {\n            var existing = document.querySelector('script[data-tonconnect-ui=\"1\"]');\n            if (existing) {\n                existing.addEventListener(\"load\", function () { resolve(); }, { once: true });\n                existing.addEventListener(\"error\", function () { reject(new Error(\"tonconnect_script_failed\")); }, { once: true });\n                return;\n            }\n\n            var script = document.createElement(\"script\");\n            script.src = \"https://unpkg.com/@tonconnect/ui@latest/dist/tonconnect-ui.min.js\";\n            script.async = true;\n            script.setAttribute(\"data-tonconnect-ui\", \"1\");\n            script.onload = function () { resolve(); };\n            script.onerror = function () { reject(new Error(\"tonconnect_script_failed\")); };\n            document.head.appendChild(script);\n        });\n\n        return tonConnectScriptLoading;\n    }\n\n    function getParentTonConnectUI() {\n        if (parentTonConnectUI) return parentTonConnectUI;\n\n        parentTonConnectUI = new TON_CONNECT_UI.TonConnectUI({\n            manifestUrl: TON_BRIDGE_MANIFEST_URL,\n            walletsListSource: TON_BRIDGE_WALLETS_LIST\n        });\n\n        parentTonConnectUI.uiOptions = {\n            twaReturnUrl: TON_BRIDGE_TWA_RETURN_URL\n        };\n\n        return parentTonConnectUI;\n    }\n\n    function waitParentTonWallet(ui) {\n        if (ui.connected && ui.wallet) return Promise.resolve();\n\n        return Promise.resolve(ui.openModal()).then(function () {\n            return new Promise(function (resolve, reject) {\n                var timeout = setTimeout(function () {\n                    reject(new Error(\"timeout\"));\n                }, 25000);\n\n                var unsubscribe = ui.onStatusChange(function (wallet) {\n                    if (wallet) {\n                        clearTimeout(timeout);\n                        unsubscribe();\n                        resolve();\n                    }\n                });\n            });\n        });\n    }\n\n    async function saveParentTonWallet(walletAddress) {\n        var tgUser = window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.initDataUnsafe && window.Telegram.WebApp.initDataUnsafe.user;\n        if (!tgUser || !tgUser.id) throw new Error(\"no_telegram_id\");\n\n        var res = await fetch(\"/api/save_wallet.php\", {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify({\n                telegram_id: tgUser.id,\n                wallet_address: walletAddress\n            })\n        });\n\n        var data = await res.json();\n        if (!data.ok) throw new Error(data.error || \"wallet_save_failed\");\n\n        return data;\n    }\n\n\n    function replyToEmbeddedProfileDeposit(requestId, payload) {\n        var iframe = getEmbeddedIframe();\n        if (!iframe || !iframe.contentWindow) return;\n\n        payload = payload || {};\n        payload.type = \"ton_deposit_result\";\n        payload.requestId = requestId || null;\n\n        iframe.contentWindow.postMessage(payload, window.location.origin);\n    }\n\n    function getParentTelegramUser() {\n        return window.Telegram &&\n            window.Telegram.WebApp &&\n            window.Telegram.WebApp.initDataUnsafe &&\n            window.Telegram.WebApp.initDataUnsafe.user;\n    }\n\n    async function getParentTonConfig() {\n        var tgUser = getParentTelegramUser();\n        if (!tgUser || !tgUser.id) throw new Error(\"no_telegram_id\");\n\n        var res = await fetch(\"/api/get_ton_config.php\", {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify({ telegram_id: tgUser.id })\n        });\n\n        var data = await res.json();\n\n        if (!data.wallet) throw new Error(data.error || \"no_ton_wallet\");\n        if (!data.payload) throw new Error(\"no_ton_payload\");\n\n        return data;\n    }\n\n    async function handleParentWalletChange(requestId) {\n        await loadTonConnectUiScript();\n\n        if (!window.TON_CONNECT_UI) {\n            throw new Error(\"tonconnect_not_loaded\");\n        }\n\n        var ui = getParentTonConnectUI();\n\n        if (ui.connected) {\n            try { await ui.disconnect(); } catch (e) {}\n        }\n\n        await waitParentTonWallet(ui);\n\n        var walletAddress = ui.wallet && ui.wallet.account && ui.wallet.account.address;\n        if (!walletAddress) throw new Error(\"no_wallet_address\");\n\n        var saved = await saveParentTonWallet(walletAddress);\n\n        replyToEmbeddedProfile(requestId, {\n            ok: true,\n            wallet: saved.wallet || walletAddress\n        });\n    }\n\n    async function handleParentDeposit(requestId, amount) {\n        amount = Number(amount || 0);\n\n        if (!amount || !isFinite(amount) || amount < 0.05) {\n            throw new Error(\"invalid_amount\");\n        }\n\n        await loadTonConnectUiScript();\n\n        if (!window.TON_CONNECT_UI) {\n            throw new Error(\"tonconnect_not_loaded\");\n        }\n\n        var ui = getParentTonConnectUI();\n\n        if (!ui.connected) {\n            await waitParentTonWallet(ui);\n        }\n\n        // Deposit must not overwrite withdrawal wallet.\n        // Withdrawal address changes only via the \"Сменить\" button.\n        var cfg = await getParentTonConfig();\n\n        var nanoAmount = Math.round(amount * 1e9).toString();\n\n        var transaction = {\n            validUntil: Math.floor(Date.now() / 1000) + 300,\n            messages: [{\n                address: cfg.wallet,\n                amount: nanoAmount,\n                payload: cfg.payload\n            }]\n        };\n\n        var result = await ui.sendTransaction(transaction);\n\n        replyToEmbeddedProfileDeposit(requestId, {\n            ok: true,\n            amount: amount,\n            boc: result && result.boc ? result.boc : null\n        });\n    }\n\n    window.addEventListener(\"message\", async function (event) {\n        if (event.origin !== window.location.origin) return;\n\n        var iframe = getEmbeddedIframe();\n        if (!iframe || event.source !== iframe.contentWindow) return;\n\n        var data = event.data || {};\n        var requestId = data.requestId || null;\n\n        if (data.type === \"ton_wallet_change_request\") {\n            try {\n                await handleParentWalletChange(requestId);\n            } catch (e) {\n                console.error(\"parent ton wallet change failed:\", e);\n                replyToEmbeddedProfile(requestId, {\n                    ok: false,\n                    error: e.message || \"wallet_change_failed\"\n                });\n            }\n            return;\n        }\n\n        if (data.type === \"ton_deposit_request\") {\n            try {\n                await handleParentDeposit(requestId, data.amount);\n            } catch (e) {\n                console.error(\"parent ton deposit failed:\", e);\n                replyToEmbeddedProfileDeposit(requestId, {\n                    ok: false,\n                    error: e.message || \"deposit_failed\"\n                });\n            }\n            return;\n        }\n    });\n\n\n    \nfunction closeLeaderboardPopup() {\n    var pop = document.getElementById(\"lb-popup\");\n    if (!pop) return;\n\n    pop.classList.remove(\"open\");\n    pop.classList.remove(\"active\");\n}\n\nfunction openLeaderboardNav() {\n    if (!isGameRoot()) {\n        window.location.href = \"/leaderboard.php\";\n        return;\n    }\n\n    openEmbeddedPage(\"/leaderboard.php\", \"leaderboard\");\n}\n\n\nfunction safeClick(id, url) {\n        var el = document.getElementById(id);\n        if (!el) return;\n\n        el.addEventListener(\"click\", function (event) {\n            event.preventDefault();\n\n            if (id === \"game\") {\n            closeLeaderboardPopup();\n                if (isGameRoot()) {\n                    closeEmbeddedPage();\n                } else {\n                    window.location.href = url;\n                }\n                return;\n            }\n\n            if (id === \"leaderboard\") {\n            openLeaderboardNav();\n            return;\n        }\n\n        if (id === \"workout\" || id === \"profile\") {\n                openEmbeddedPage(url, id);\n                return;\n            }\n\n            window.location.href = url;\n        });\n    }\n\n    safeClick(\"game\", \"/\");\n    safeClick(\"workout\", \"/workout\");\n    safeClick(\"leaderboard\", \"/leaderboard.php\");\nsafeClick(\"profile\", \"/profile\");\n\n\nif (isGameRoot()) {\n    try {\n        var params = new URLSearchParams(window.location.search);\n        if (params.get(\"leaderboard\") === \"1\") {\n            setTimeout(function () {\n                openLeaderboardNav();\n\n                if (window.history && window.history.replaceState) {\n                    window.history.replaceState(null, \"\", window.location.pathname);\n                }\n            }, 500);\n        }\n    } catch (e) {}\n}\n\n})();\n"
          },
